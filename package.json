{
  "name": "mingstar-brand-promo-agent",
  "packageManager": "pnpm@10.18.3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自动化品宣机器人 Agent —— 基于 Mastra 的品牌宣传片自动生成 Web 应用（铭星链 MingStar 子项目）",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:real": "node --env-file=.env src/server.js",
    "dev:real": "node --env-file=.env --watch src/server.js",
    "probe:tikhub": "node --env-file=.env tools/probe-tikhub.mjs",
    "test": "node --import ./tests/setup.mjs --test-concurrency=1 --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@mastra/core": "^1.63.2",
    "express": "^4.21.2",
    "fontkit": "^2.0.4",
    "zod": "^3.23.8"
  }
}
