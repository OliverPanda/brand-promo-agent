# ╔══════════════════════════════════════════════════════════════════════════╗
# 自动化品宣机器人 Agent —— 环境变量示例（复制为 .env 后按需填写）
# 默认（不设置模式变量）= REAL 真实交付模式；缺少必需配置时预检会在付费调用前失败。
# 需要零外部调用的离线演示时，须显式设 PROMO_PROVIDER_MODE=demo。
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── 舆情雷达数据源：TikHub（多平台社媒数据 API，https://user.tikhub.io）──
# 密钥仅服务端持有；复制本文件为 .env 后填入真实值（.env 已被 gitignore 覆盖，不入库）
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=

# ── 舆情雷达 · LLM 情绪打分（M2，real 模式走 one-api 批量打分；DEMO 走确定性特征词）──
# 打分模型（留空回退 PROMO_LLM_MODEL > deepseek-v4-flash）
# PROMO_RADAR_NLP_MODEL=deepseek-v4-flash
# 单次 LLM 请求打包条数上限（默认 20）
# PROMO_NLP_BATCH_SIZE=20
# 每日 LLM 打分条数预算（0 = 不限；超限当日自动降级词典规则，不报错仅精度下降）
# PROMO_NLP_DAILY_CAP=0
# 单批 LLM 请求超时（毫秒，默认 60000）
# PROMO_NLP_TIMEOUT_MS=60000
# 选题生成模型（M3，留空回退 PROMO_RADAR_NLP_MODEL > PROMO_LLM_MODEL > deepseek-v4-flash）
# PROMO_RADAR_TOPIC_MODEL=deepseek-v4-flash
# 每日选题产出条数（默认 10）
# PROMO_RADAR_TOPIC_COUNT=10

# ── 运行模式 ──
# real = 真实 Provider（one-api，默认）；demo = 显式离线演示
PROMO_PROVIDER_MODE=real

# ── one-api（OpenAI 兼容统一网关）凭据 ──
# 与 MingStar 现行通道一致，优先用 PROMO_ONEAPI_*；缺失时回退到 MINGSTAR_LLM_* / OPENAI_*
# 环境变量是「兜底」：前端「模型与服务」面板保存的 地址/模式/API Key 优先于本行
# （写入 data/runtime-config.json，免重启生效；密钥为可写不可读——保存后仅回显是否已配置，
#   明文绝不下发前端/不回显；把该项清空保存 = 清除运行时覆盖、回落本 env）。
PROMO_ONEAPI_BASE_URL=https://your-one-api.example/v1
PROMO_ONEAPI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 各能力模型（均为可选项，留空使用下方默认值）──
# 脚本 / 分镜（LLM）
PROMO_LLM_MODEL=deepseek-v4-flash
# 可选模型清单（逗号分隔，供前端下拉；Brief.llmModel/imageModel 可请求级覆盖）
PROMO_LLM_CHOICES=deepseek-v4-flash,deepseek-v4,qwen3-max,glm-5
PROMO_IMAGE_CHOICES=doubao-seedream-4-0-250828,doubao-seedream-3-0-t2i
# 场景图（Seedream 等文生图）
PROMO_IMAGE_MODEL=doubao-seedream-4-0-250828
PROMO_IMAGE_SIZE=1024x576
# 配音（TTS）
PROMO_TTS_MODEL=speech-02-hd
# 配乐（Mureka 桥，经 one-api 音乐通道）
PROMO_MUSIC_MODEL=mureka-v1
PROMO_MUSIC_PATH=/audio/music
# 动态视频（图生/文生）：真实渠道清单在连网后由 GET /api/models 自动从网关拉取（无需在此枚举），
# 前端「模型与服务」面板据此展示可选项。此变量仅作「未显式选择时的默认」。
# 视频清单已按「真生成本体」收紧：kling-image/tts/effects、sora_image、veo3.1-*-components、
# wan2.2-animate-*、runway-act_* 等子能力 API 会被剔除回落到 audio/image/llm 类，不再混入 video。
PROMO_VIDEO_MODEL=
# 单镜视频异步任务轮询超时 / 间隔 / 提交接口超时 / GET /models 拉取超时（毫秒，均有默认）
# PROMO_VIDEO_TIMEOUT_MS=180000
# PROMO_VIDEO_POLL_MS=3000
# PROMO_VIDEO_SUBMIT_TIMEOUT_MS=30000
# PROMO_MODELS_TIMEOUT_MS=5000

# ── 服务端 FFmpeg（真实 MP4 合成）──
# REAL 请求在创建 run 前校验可执行文件、subtitles/libass 滤镜和中文字幕字体；缺失时返回 503
PROMO_FFMPEG_BIN=/usr/bin/ffmpeg
PROMO_FFPROBE_BIN=/usr/bin/ffprobe
# 中文字体文件路径或精确系统字体名；REAL 预检会校验 cmap 中文 glyph，拒绝字体回退
PROMO_SUBTITLE_FONT=Microsoft YaHei
# 成片与运行工作区输出根目录；默认 <PROMO_DATA_DIR>/outputs
PROMO_OUTPUT_ROOT=./data/outputs

# ── 成本与预算（FR-10）──
# 每次运行预算上限（元）；每次运行实时读取，便于不改代码调整。默认 20
PROMO_BUDGET_CAP=20
# 动态视频按量模型的每镜回落单价（元/镜）。中转站按次模型（sora-2-pro ¥3.65、sora-2 ¥2.19）
# 走 cost.js 内 VIDEO_PER_CALL_CNY 真实价；其余视频模型（站内兜底倍率 37.5，按 tokens 结算、无固定每镜价）用本回落价。默认 1
# PROMO_VIDEO_COST_FALLBACK=1

# ── 账户级累计配额（M3「成本配额」/ FR-10）──
# 单个账户（createdBy=品牌名）跨多次运行的累计花费上限（元）。默认 200。
# 真实 Provider 产生费用时扣减；DEMO 零成本不计。超限中止该次运行并提示。
PROMO_QUOTA_CAP=200

# ── 运行态持久化（M3「历史记录」）──
# 关闭则运行态仅存内存、重启清空（测试用）；默认 1 开启，落盘到 PROMO_DATA_DIR。
PROMO_PERSIST=1
# 持久化目录（运行态 runs.json + 配额 quotas.json）；默认 <项目根>/data
PROMO_DATA_DIR=./data

# ── 服务端口（可选）──
PORT=3000                                # 默认端口；被占用时自动 +1 探测（最多 10 次，如 3001/3002…）

# ── 调试：每步人为延迟（毫秒），DEMO 模式让 SSE 进度可见；生产可设 0 ──
STEP_DELAY_MS=400
