# ╔══════════════════════════════════════════════════════════════════════════╗
# 自动化品宣机器人 Agent —— 环境变量示例（复制为 .env 后按需填写）
# 默认（不设置任何变量）= DEMO 离线模式：零外部密钥、确定性占位输出，可直接 npm start。
# 设 PROMO_PROVIDER_MODE=real 即切换到真实 one-api（OpenAI 兼容）通道，产出真实素材/MP4。
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── 运行模式 ──
# real = 真实 Provider（one-api）；留空/其他 = DEMO（默认，安全离线）
PROMO_PROVIDER_MODE=demo

# ── one-api（OpenAI 兼容统一网关）凭据 ──
# 与 MingStar 现行通道一致，优先用 PROMO_ONEAPI_*；缺失时回退到 MINGSTAR_LLM_* / OPENAI_*
PROMO_ONEAPI_BASE_URL=https://your-one-api.example/v1
PROMO_ONEAPI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 各能力模型（均为可选项，留空使用下方默认值）──
# 脚本 / 分镜（LLM）
PROMO_LLM_MODEL=deepseek-v4-flash
# 场景图（Seedream 等文生图）
PROMO_IMAGE_MODEL=doubao-seedream-4-0-250828
PROMO_IMAGE_SIZE=1024x576
# 配音（TTS）
PROMO_TTS_MODEL=tiny-iceberg
# 配乐（Mureka 桥，经 one-api 音乐通道）
PROMO_MUSIC_MODEL=mureka-v1
PROMO_MUSIC_PATH=/audio/music

# ── 服务端 FFmpeg（真实 MP4 合成）──
# 配齐则合成为 file://...mp4；缺失/失败时优雅降级为分镜包（不阻断交付）
PROMO_FFMPEG_BIN=/usr/bin/ffmpeg

# ── 成本与预算（FR-10）──
# 每次运行预算上限（元）；每次运行实时读取，便于不改代码调整。默认 20
PROMO_BUDGET_CAP=20

# ── 账户级累计配额（M3「成本配额」/ FR-10）──
# 单个账户（createdBy=品牌名）跨多次运行的累计花费上限（元）。默认 200。
# 真实 Provider 产生费用时扣减；DEMO 零成本不计。超限中止该次运行并提示。
PROMO_QUOTA_CAP=200

# ── 运行态持久化（M3「历史记录」）──
# 关闭则运行态仅存内存、重启清空（测试用）；默认 1 开启，落盘到 PROMO_DATA_DIR。
PROMO_PERSIST=1
# 持久化目录（运行态 runs.json + 配额 quotas.json）；默认 <项目根>/data
PROMO_DATA_DIR=./data

# ── 服务端口（可选）──
PORT=3000                                # 默认端口；被占用时自动 +1 探测（最多 10 次，如 3001/3002…）

# ── 调试：每步人为延迟（毫秒），DEMO 模式让 SSE 进度可见；生产可设 0 ──
STEP_DELAY_MS=400
